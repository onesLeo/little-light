[sub_resource type="Resource" id="Line_arrive"]
script = ExtResource("2_line")
id = &"arrive"
speaker = "Wonder Light"
text = "This is David's valley. He looks after sheep. God looks after him."
clip = ExtResource("wl_arrive")
easy_text = "This is David's valley. God looks after him."
easy_clip = ExtResource("ez_arrive")

[sub_resource type="Resource" id="Line_explore"]
script = ExtResource("2_line")
id = &"explore"
speaker = "Wonder Light"
text = "David needs his stone, his staff, and his little lamb. Find them for him!"
clip = ExtResource("wl_explore")
easy_text = "Find David's stone, staff, and little lamb."
easy_clip = ExtResource("ez_explore")

[sub_resource type="Resource" id="Line_item_stone"]
script = ExtResource("2_line")
id = &"item_stone"
speaker = "Wonder Light"
text = "A small stone. God can use even a small thing."
clip = ExtResource("wl_item_stone")

[sub_resource type="Resource" id="Line_item_staff"]
script = ExtResource("2_line")
id = &"item_staff"
speaker = "Wonder Light"
text = "A shepherd's staff. David stays with his sheep."
clip = ExtResource("wl_item_staff")
easy_text = "David's staff. He stays with his sheep."
easy_clip = ExtResource("ez_item_staff")

[sub_resource type="Resource" id="Line_item_lamb"]
script = ExtResource("2_line")
id = &"item_lamb"
speaker = "Wonder Light"
text = "A lamb David is keeping safe. That is his job."
clip = ExtResource("wl_item_lamb")

[sub_resource type="Resource" id="Line_bring_items"]
script = ExtResource("2_line")
id = &"bring_items"
text = "You bring David the stone, staff, and little lamb."

[sub_resource type="Resource" id="Line_david_hello"]
script = ExtResource("2_line")
id = &"david_hello"
speaker = "David"
text = "Oh! Hello there. Are you lost too?"
clip = ExtResource("dv_hello")

[sub_resource type="Resource" id="Line_david_giant"]
script = ExtResource("2_line")
id = &"david_giant"
speaker = "David"
text = "Everyone's scared of the big giant. But God gave me these sheep to keep safe."
clip = ExtResource("dv_giant")
easy_text = "Everyone is afraid of the big giant. God gave me these sheep to keep safe."
easy_clip = ExtResource("ez_giant")

[sub_resource type="Resource" id="Line_david_lion_bear"]
script = ExtResource("2_line")
id = &"david_lion_bear"
speaker = "David"
text = "The Lord kept me safe from the lion and the bear. He will keep me safe now."
clip = ExtResource("dv_lion_bear")
easy_text = "God kept me safe before. He will keep me safe now."
easy_clip = ExtResource("ez_lion_bear")

[sub_resource type="Resource" id="Line_david_job"]
script = ExtResource("2_line")
id = &"david_job"
speaker = "Wonder Light"
text = "God gave David a job: keep the sheep safe. That's why he will go."
clip = ExtResource("wl_david_scared")
easy_text = "God gave David a job: keep the sheep safe."
easy_clip = ExtResource("ez_david_scared")

[sub_resource type="Resource" id="Line_david_stay_close"]
script = ExtResource("2_line")
id = &"david_stay_close"
speaker = "David"
text = "Thanks. Will you stay close while I get ready?"
clip = ExtResource("dv_stay_close")

[sub_resource type="Resource" id="Line_yahweh"]
script = ExtResource("2_line")
id = &"yahweh"
speaker = "Wonder Light"
text = "Yahweh is God's name. It means He is with you."
clip = ExtResource("wl_yahweh")

[sub_resource type="Resource" id="Line_three_words"]
script = ExtResource("2_line")
id = &"three_words"
speaker = "Wonder Light"
text = "This verse has three special words. Can you say them with me?"
clip = ExtResource("wl_three_words")

[sub_resource type="Resource" id="Line_dont_be_afraid"]
script = ExtResource("2_line")
id = &"dont_be_afraid"
speaker = "Wonder Light"
text = "Don't. Be. Afraid."
clip = ExtResource("wl_dont_be_afraid")
same_quote = true

[sub_resource type="Resource" id="Line_steady_intro"]
script = ExtResource("2_line")
id = &"steady_intro"
speaker = "Wonder Light"
text = "Let's breathe God's promise with David. In: God is with you. Out: don't be afraid."
clip = ExtResource("wl_steady_intro")
easy_text = "Let's breathe God's words with David. In... God is with you. Out... do not be afraid."
easy_clip = ExtResource("ez_steady_intro")

[sub_resource type="Resource" id="Line_in_and_out"]
script = ExtResource("2_line")
id = &"in_and_out"
speaker = "David"
text = "In... and out. Just like counting sheep."
clip = ExtResource("dv_in_and_out")

[sub_resource type="Resource" id="Line_breathe"]
script = ExtResource("2_line")
id = &"breathe"
speaker = "Wonder Light"
text = "Breathe with David..."
clip = ExtResource("wl_breathe")

[sub_resource type="Resource" id="Line_steady_now"]
script = ExtResource("2_line")
id = &"steady_now"
speaker = "David"
text = "I still feel small. But I'm not alone. Thank you for staying."
clip = ExtResource("dv_steady_now")
easy_text = "I am still small. But I am not alone."
easy_clip = ExtResource("ez_steady_now")

[sub_resource type="Resource" id="Line_took_stone"]
script = ExtResource("2_line")
id = &"took_stone"
speaker = "Wonder Light"
text = "David took the small stone. God can use even a small thing."
clip = ExtResource("wl_took_stone")

[sub_resource type="Resource" id="Line_resolution"]
script = ExtResource("2_line")
id = &"resolution"
speaker = "Wonder Light"
text = "David walked out to the valley. When it was over, the camp cheered his name."
clip = ExtResource("wl_resolution")
easy_text = "David walked out to the valley. Then everyone cheered."
easy_clip = ExtResource("ez_resolution")

[sub_resource type="Resource" id="Line_resolution_clear"]
script = ExtResource("2_line")
id = &"resolution_clear"
speaker = "Wonder Light"
text = "David trusted God, faced Goliath with his sling, and defeated him. The people were safe."
clip = ExtResource("wl_resolution_clear")

[sub_resource type="Resource" id="Line_reflect"]
script = ExtResource("2_line")
id = &"reflect"
speaker = "Wonder Light"
text = "Being brave doesn't mean you're not scared. It means you go with God anyway."
clip = ExtResource("wl_reflect")
easy_text = "Being brave does not mean you are never scared. It means you go with God."
easy_clip = ExtResource("ez_reflect")

[sub_resource type="Resource" id="Line_purpose"]
script = ExtResource("2_line")
id = &"purpose"
speaker = "Wonder Light"
text = "God had a job for David. He has one for you too. Stay close, and remember the words."
clip = ExtResource("wl_purpose")
easy_text = "God had a job for David. He has one for you too. Stay close."
easy_clip = ExtResource("ez_purpose")

[sub_resource type="Resource" id="Line_charm"]
script = ExtResource("2_line")
id = &"charm"
speaker = "Wonder Light"
text = "A Courage charm — for staying with David, and breathing God's promise with him."
clip = ExtResource("wl_charm")

[sub_resource type="Resource" id="Line_charm_arrives"]
script = ExtResource("2_line")
id = &"charm_arrives"
text = "Virtue Bracelet receives the charm."

[sub_resource type="Resource" id="Line_keep_close"]
script = ExtResource("2_line")
id = &"keep_close"
speaker = "Wonder Light"
text = "Keep this close. Courage is yours to carry."
clip = ExtResource("wl_keep_close")
easy_text = "Keep it close. Courage is yours."
easy_clip = ExtResource("ez_keep_close")

[sub_resource type="Resource" id="Line_charm_sealed"]
script = ExtResource("2_line")
id = &"charm_sealed"
text = "Courage charm sealed on the Virtue Bracelet."

[sub_resource type="Resource" id="Line_complete"]
script = ExtResource("2_line")
id = &"complete"
speaker = "Wonder Light"
text = "God was with David. God is with you."
clip = ExtResource("wl_complete")

[resource]
script = ExtResource("1_lines")
lines = Array[Resource]([SubResource("Line_arrive"), SubResource("Line_explore"), SubResource("Line_item_stone"), SubResource("Line_item_staff"), SubResource("Line_item_lamb"), SubResource("Line_bring_items"), SubResource("Line_david_hello"), SubResource("Line_david_giant"), SubResource("Line_david_lion_bear"), SubResource("Line_david_job"), SubResource("Line_david_stay_close"), SubResource("Line_yahweh"), SubResource("Line_three_words"), SubResource("Line_dont_be_afraid"), SubResource("Line_steady_intro"), SubResource("Line_in_and_out"), SubResource("Line_breathe"), SubResource("Line_steady_now"), SubResource("Line_took_stone"), SubResource("Line_resolution"), SubResource("Line_resolution_clear"), SubResource("Line_reflect"), SubResource("Line_purpose"), SubResource("Line_charm"), SubResource("Line_charm_arrives"), SubResource("Line_keep_close"), SubResource("Line_charm_sealed"), SubResource("Line_complete")])
